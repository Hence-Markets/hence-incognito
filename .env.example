# hence-incognito — every value empty by default.
# Convention borrowed from the main app: an EMPTY value means the feature is OFF and
# the code path no-ops. Never ship a default that silently enables something.

# ── Identity ────────────────────────────────────────────────────────────────
# SAME Privy app as the main Hence app — that is what makes it the same user.
# incognito.hence.markets must be added to Privy's allowed origins or login fails.
VITE_PRIVY_APP_ID=

# Which phase's claims the UI is allowed to make. 1 = shielded execution (identity hidden,
# position public). 2 = bounded netting (matched orders never reach a public venue).
# DEFAULTS TO 1 IF UNSET OR WRONG — a misconfigured deploy must underclaim, never overclaim.
# Only set this to 2 once crossing is actually running.
VITE_PHASE=1

# ── Inco Lightning ──────────────────────────────────────────────────────────
# 'testnet' = Base Sepolia (default, use this first) · 'mainnet' = Base
VITE_NETWORK=testnet
VITE_INCOGNITO_CONTRACT=

# ── Avantis (Base) ──────────────────────────────────────────────────────────
# VERIFIED 2026-08-15 against the live GET /v2/meta — no longer second-hand research.
# Addresses live in web/src/lib/avantis.ts; only the endpoints and the builder code are env.
#
# The published SDK is PYTHON ONLY (avantis_trader_sdk) and we do not need it: it wraps a
# plain HTTP API. Build -> sign -> submit, from TypeScript, no SDK.
AVANTIS_TX_BUILDER=https://tx-builder.avantisfi.com
AVANTIS_TX_BUILDER_TESTNET=https://tx-builder-testnet.avantisfi.com
# Builder/partner attribution. Avantis DOES have builder codes (referral contract
# 0x1A110bBA13A1f16cCa4b79758BD39290f29De82D + a 'referral' EIP-712 domain), which answers
# the open monetisation question. Register one and set it here; empty = unattributed.
AVANTIS_BUILDER_CODE=

# ── Keeper ──────────────────────────────────────────────────────────────────
# Omnibus funder. THIS IS THE ANONYMITY SET — fund it with the test budget only,
# never a treasury key. Keep the balance capped.
OMNIBUS_PRIVATE_KEY=
EPOCH_SECONDS=300
DATABASE_URL=

# ── Access ──────────────────────────────────────────────────────────────────
# Comma/space-separated wallet addresses allowed into the prototype. SERVER-SIDE ONLY —
# deliberately NOT prefixed VITE_, because anything the Vite client can read is compiled
# into the public bundle. The browser only ever learns a yes/no about its own address.
# EMPTY = nobody gets in (fail closed). This is the opposite of the main app's rebate
# whitelist, where empty means "open to everyone" — do not copy that convention here.
TEAM_WALLETS=

# ── Safety rails ────────────────────────────────────────────────────────────
MAX_ORDER_USD=100
DRY_RUN=1
