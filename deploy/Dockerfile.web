# The Incognito web app: Vite build → nginx.
#
# VITE_* ARE BUILD-TIME, NOT RUNTIME. Vite inlines them into the bundle, so they must arrive as
# build args — setting them in the container environment later does nothing, silently, and the
# app falls back to its defaults (no contract address → the epoch panel drops to a local clock
# and quietly stops being live). That failure mode has already cost an hour once in dev.
#
# None of these are secrets: a Privy app ID and a contract address are both public by nature and
# visible in the shipped bundle regardless. The keeper's key is the secret, and it lives in the
# OTHER image, as a runtime env var, never here.

FROM node:22-alpine AS build
WORKDIR /src

# web/ installs standalone — npm workspaces hoisting split @types/react 18/19 and broke the fork.
COPY web/package.json web/package-lock.json* ./
RUN npm install --no-audit --no-fund

COPY web/ ./

ARG VITE_PRIVY_APP_ID
ARG VITE_INCOGNITO_CONTRACT
ARG VITE_NETWORK=testnet
ARG VITE_EPOCH_SECONDS=120
ARG VITE_PHASE=2
ENV VITE_PRIVY_APP_ID=$VITE_PRIVY_APP_ID \
    VITE_INCOGNITO_CONTRACT=$VITE_INCOGNITO_CONTRACT \
    VITE_NETWORK=$VITE_NETWORK \
    VITE_EPOCH_SECONDS=$VITE_EPOCH_SECONDS \
    VITE_PHASE=$VITE_PHASE

# Fail the build rather than shipping an app that renders a countdown from nowhere.
RUN test -n "$VITE_INCOGNITO_CONTRACT" || (echo "VITE_INCOGNITO_CONTRACT is required" && exit 1)
RUN test -n "$VITE_PRIVY_APP_ID" || (echo "VITE_PRIVY_APP_ID is required" && exit 1)

RUN npx vite build

FROM nginx:alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html
EXPOSE 80
